#
# One entry point for everything in this repository.
#
#   ./omarchy-on-cachyos            # menu
#   ./omarchy-on-cachyos status     # print state and exit
#
# Every action is a script in this directory, runnable on its own. Nothing here
# is hidden behind the menu.

set -uo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

BLUE="#7aa2f7"; PURPLE="#bb9af7"; GREEN="#9ece6a"
RED="#f7768e";  ORANGE="#ff9e64"; MUTED="#9aa5ce"; FG="#c0caf5"

have_gum() { command -v gum >/dev/null 2>&1; }

# Plain-text equivalents so the script still works without gum installed.
if have_gum; then
  head()  { gum style --foreground "$FG" --border rounded --border-foreground "$PURPLE" \
              --padding "0 2" --margin "1 0 0 0" --align center --width 62 "$@"; }
  note()  { gum style --foreground "$MUTED" "$@"; }
  good()  { gum style --foreground "$GREEN"  "$@"; }
  bad()   { gum style --foreground "$RED"    "$@"; }
  warny() { gum style --foreground "$ORANGE" "$@"; }
else
  head()  { printf '\n== %s ==\n' "$*"; }
  note()  { printf '   %s\n' "$*"; }
  good()  { printf '   [ok] %s\n' "$*"; }
  bad()   { printf '   [--] %s\n' "$*"; }
  warny() { printf '   [!!] %s\n' "$*"; }
fi

yes_no() {  # yes_no "question" -> 0 if confirmed
  if have_gum; then
    gum confirm --prompt.foreground "$FG" \
      --selected.background "$BLUE" --selected.foreground "#1a1b26" "$1"
  else
    read -rp "$1 [y/N] " a; [[ ${a,,} == y* ]]
  fi
}

# ---------------------------------------------------------------- state
st_installed=0; st_session=0; st_guards=0; st_blocked=0; st_identity=0; st_desktop=0
detect() {
  pacman -Qq omarchy &>/dev/null && st_installed=1
  [[ -e /usr/share/wayland-sessions/omarchy.desktop ]] && st_session=1
  grep -q 'omarchy-on-cachyos guards' /etc/pacman.conf 2>/dev/null && st_guards=1
  grep -q 'OMARCHY-BLOCKED-GUARD' /usr/bin/omarchy-update 2>/dev/null && st_blocked=1
  [[ -f /usr/share/libalpm/hooks/99-restore-distro-identity.hook ]] && st_identity=1
  [[ -f "$HOME/.local/share/applications/omarchy-window.desktop" ]] && st_desktop=1
}

row() { # row <label> <0|1> <yes-text> <no-text>
  local l="$1" v="$2" y="$3" n="$4"
  if (( v )); then good "$(printf '  %-22s %s' "$l" "$y")"
  else            warny "$(printf '  %-22s %s' "$l" "$n")"; fi
}

status() {
  detect
  head "omarchy-on-cachyos"
  note ""
  row "Omarchy packages"  "$st_installed" "installed"            "not installed"
  row "Login session"     "$st_session"   "registered"           "not registered"
  row "pacman guards"     "$st_guards"    "active"               "MISSING - boot at risk"
  row "Destructive cmds"  "$st_blocked"   "blocked"              "runnable"
  row "Distro identity"   "$st_identity"  "preserved"            "Omarchy's branding will return"
  row "Window launcher"   "$st_desktop"   "installed"            "not installed"
  note ""
  note "  $( . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}" ) · plymouth: $(plymouth-set-default-theme 2>/dev/null || echo '?')"
  note ""
}

run() { # run <script> [args...]
  local s="$HERE/$1"; shift
  [[ -x $s ]] || { bad "missing: $s"; return 1; }
  echo
  note "  \$ ./$(basename "$s") $*"
  echo
  "$s" "$@"
  local rc=$?
  echo
  (( rc == 0 )) && good "  finished" || bad "  exited $rc"
  return $rc
}

pause() { echo; read -rsn1 -p "  press any key to return to the menu " _ ; echo; }

# ---------------------------------------------------------------- menu
menu() {
  local choice
  local -a items=(
    "Status — show what is set up"
    "Open Omarchy in a window"
    "Install launcher entry (icon, no terminal)"
    "Install Omarchy — dry run (changes nothing)"
    "Install Omarchy — for real"
    "Block the destructive commands"
    "Preserve this distro's identity"
    "Verify I can still boot"
    "Verify + rebuild initramfs"
    "Reclaim orphaned /boot entries"
    "Uninstall Omarchy"
    "Quit"
  )
  if have_gum; then
    choice=$(printf '%s\n' "${items[@]}" | gum choose --height 14 \
      --header "What would you like to do?" \
      --header.foreground "$MUTED" \
      --cursor.foreground "$BLUE" --selected.foreground "$GREEN") || return 1
  else
    local i=1; for it in "${items[@]}"; do printf '  %2d) %s\n' "$i" "$it"; ((i++)); done
    read -rp "  choice: " i; choice="${items[$((i-1))]:-Quit}"
  fi

  case "$choice" in
    Status*)              status ;;
    "Open Omarchy in a window")
                          run omarchy-window --bare --detach ;;
    "Install launcher entry"*)
                          run omarchy-window --install-desktop ;;
    *"dry run"*)          run install-omarchy-on-cachyos.sh --dry-run ;;
    *"for real")          yes_no "Install Omarchy onto this system?" && \
                          run install-omarchy-on-cachyos.sh ;;
    "Block the destructive"*)
                          run block-omarchy-updates.sh ;;
    "Preserve this distro"*)
                          yes_no "Restore and pin this distribution's branding?" && \
                          run preserve-cachyos-identity.sh --apply ;;
    "Verify I can still boot")
                          run verify-reboot-safety.sh ;;
    "Verify + rebuild"*)  yes_no "Regenerate the initramfs now?" && \
                          run verify-reboot-safety.sh --rebuild ;;
    "Reclaim orphaned"*)  run clean-stale-boot-entries.sh ;;
    "Uninstall Omarchy")  yes_no "Remove Omarchy from this system?" && \
                          run uninstall-omarchy-on-cachyos.sh ;;
    Quit|"")              return 1 ;;
  esac
  return 0
}

case "${1:-}" in
  status) status; exit 0 ;;
  -h|--help) sed -n '4,12p' "$0" | sed 's/^# \?//'; exit 0 ;;
esac

have_gum || note "gum is not installed - falling back to a plain menu."
status
while menu; do pause; status; done
echo
note "  Every action above is also a standalone script in $HERE"
echo
