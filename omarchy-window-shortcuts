#
# omarchy-window-shortcuts - lend Omarchy the Meta+ keys it needs, without
# taking Plasma's Super menu or Alt+Tab away.
#
#   omarchy-window-shortcuts suppress   free every Meta+<key> bind for Omarchy
#   omarchy-window-shortcuts restore    put them all back
#   omarchy-window-shortcuts status     say what is suppressed right now
#
# Add --dry-run to suppress or restore to see the plan without touching a thing.
#
# More than one nested window can be open at once, and each wants the same keys.
# So the borrow is reference counted: `suppress --claim PID` records a holder,
# `restore --release PID` drops one and only hands the keys back when the last
# holder is gone. Without that, closing one window took the keys away from every
# other window still using them.
#
# A holder is a pid plus that process's start time, so a recycled pid cannot be
# mistaken for a session that is still alive. Dead holders are pruned on every
# operation, which is what makes a killed session self-healing. A bare `restore`
# ignores holders entirely and puts everything back - that is the escape hatch,
# and it is what the menu offers.
#
# Why not blockGlobalShortcuts, which is what this replaced: it is all or
# nothing. It also silences Super on its own - KWin's modifier-only launcher
# shortcut - and Alt+Tab, neither of which Omarchy uses and both of which you
# still want from Plasma.
#
# So rather than blocking everything, this clears only the key combinations
# that carry the Meta modifier. That single rule gives both exceptions for
# free:
#
#   * Super alone is a KWin modifier-only shortcut, not a KGlobalAccel
#     binding, so it is never enumerated and never touched.
#   * Alt+Tab survives because "Walk Through Windows" is bound to both
#     Meta+Tab and Alt+Tab, and only the Meta alternate is removed.
#
# Everything that is about to change is written to a backup file *first*, and
# `restore` replays it. If a session is killed before it can restore, the
# backup stays on disk and both `status` and the omarchy-on-cachyos menu will
# offer to put things back. KDE also leaves each action's *default* column
# alone, so even a deleted backup is recoverable from
# System Settings -> Shortcuts -> Reset to Defaults.

set -euo pipefail

BACKUP="${OC_KDE_SHORTCUT_BACKUP:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-cachyos/kde-shortcuts.backup.json}"
DRYRUN=0
ACTION=""
HOLDER=""

while (($#)); do
  case "$1" in
    suppress | restore | status) ACTION="$1"; shift ;;
    --dry-run) DRYRUN=1; shift ;;
    --claim | --release)
      HOLDER="${2:?$1 needs a pid}"
      [[ $HOLDER =~ ^[0-9]+$ ]] || { echo "$1 needs a pid, got: $HOLDER" >&2; exit 1; }
      shift 2 ;;
    -h | --help) sed -n '2,12p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 1 ;;
  esac
done
[[ -n $ACTION ]] || { sed -n '2,12p' "$0" | sed 's/^# \?//'; exit 1; }

for dep in gdbus python3; do
  command -v "$dep" >/dev/null 2>&1 || {
    echo "omarchy-window-shortcuts: needs $dep, which is not installed" >&2
    echo "  -> sudo pacman -S --needed glib2 python" >&2
    exit 1
  }
done

if ! gdbus call -e -d org.kde.kglobalaccel -o /kglobalaccel \
     -m org.kde.KGlobalAccel.allMainComponents >/dev/null 2>&1; then
  echo "omarchy-window-shortcuts: KDE's global shortcut service is not answering" >&2
  echo "  This only works inside a running Plasma session." >&2
  echo "  -> if you are in Plasma, check:  qdbus6 org.kde.kglobalaccel" >&2
  exit 1
fi

BACKUP="$BACKUP" DRYRUN="$DRYRUN" HOLDER="$HOLDER" python3 - "$ACTION" <<'PY'
import ast, json, os, subprocess, sys, tempfile
from datetime import datetime, timezone

ACTION = sys.argv[1]
BACKUP = os.environ["BACKUP"]
DRYRUN = os.environ["DRYRUN"] == "1"
HOLDER = os.environ.get("HOLDER") or ""
META = 0x10000000


def proc_start(pid):
    """That process's start time, or None if it is not running.

    Paired with the pid this identifies one specific process: a pid that has
    been recycled since the claim will not match, so a dead session can never
    be mistaken for a live one and hold the keys hostage.
    """
    try:
        with open(f"/proc/{int(pid)}/stat") as f:
            stat = f.read()
    except (OSError, ValueError):
        return None
    # comm sits in parentheses and may itself contain spaces or ')', so split
    # on the LAST ')' rather than on whitespace.
    fields = stat[stat.rfind(")") + 2:].split()
    return fields[19] if len(fields) > 19 else None


def tracked(data):
    """Whether this backup records holders at all.

    A v1 backup written before reference counting has no holders key. That is
    "unknown", not "nobody" - reading it as nobody would report a false fault,
    or hand back keys that windows opened by the older version are still using.
    """
    return data.get("holders") is not None


def live_holders(holders):
    """Drop holders whose process is gone. This is the self-healing step."""
    alive = []
    for h in holders or []:
        try:
            pid, start = int(h["pid"]), h.get("start")
        except (TypeError, ValueError, KeyError):
            continue
        if proc_start(pid) == start:
            alive.append({"pid": pid, "start": start})
    return alive

# Qt packs the modifiers into the high bits of the key combination; the low bits
# are the key itself. We only care whether the Meta bit is lit.
MODS = ((0x10000000, "Meta"), (0x08000000, "Alt"), (0x04000000, "Ctrl"), (0x02000000, "Shift"))
# Only the codes worth spelling out. The multimedia block (0x010000A8 and up) is
# left as hex on purpose: a wrong name would read worse than an honest number.
NAMED = {
    0x01000000: "Esc", 0x01000001: "Tab", 0x01000002: "Backtab",
    0x01000003: "Backspace", 0x01000004: "Return", 0x01000005: "Enter",
    0x01000006: "Insert", 0x01000007: "Delete", 0x01000009: "Print",
    0x01000010: "Home", 0x01000011: "End", 0x01000012: "Left",
    0x01000013: "Up", 0x01000014: "Right", 0x01000015: "Down",
    0x01000016: "PgUp", 0x01000017: "PgDown", 0x20: "Space",
}
NAMED.update({0x0100002F + n: f"F{n}" for n in range(1, 36)})


def human(k):
    parts = [n for bit, n in MODS if k & bit]
    key = k & ~0x1E000000
    parts.append(NAMED.get(key, chr(key) if 0x20 < key < 0x7F else hex(key)))
    return "+".join(parts)


def gv_strings(items):
    """Render a list of strings as GVariant text, quoting safely."""
    out = []
    for s in items:
        out.append("'" + str(s).replace("\\", "\\\\").replace("'", "\\'") + "'")
    return "[" + ", ".join(out) + "]"


def call(method, *args):
    cmd = ["gdbus", "call", "-e", "-d", "org.kde.kglobalaccel", "-o", "/kglobalaccel",
           "-m", "org.kde.KGlobalAccel." + method] + list(args)
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        return ast.literal_eval(r.stdout.strip())
    except (ValueError, SyntaxError):
        return None


def set_keys(action_id, keys):
    arg = "@ai []" if not keys else "[" + ", ".join(str(k) for k in keys) + "]"
    cmd = ["gdbus", "call", "-e", "-d", "org.kde.kglobalaccel", "-o", "/kglobalaccel",
           "-m", "org.kde.KGlobalAccel.setForeignShortcut", gv_strings(action_id), arg]
    return subprocess.run(cmd, capture_output=True, text=True).returncode == 0


def scan():
    """Every action that has at least one Meta+<key> combination."""
    comps = call("allMainComponents")
    comps = comps[0] if comps else []
    found = []
    for comp in comps:
        acts = call("allActionsForComponent", gv_strings(list(comp)))
        acts = acts[0] if acts else []
        for act in acts:
            got = call("shortcut", gv_strings(list(act)))
            if not got:
                continue
            keys = list(got[0])
            kept = [k for k in keys if not (k & META)]
            if len(kept) != len(keys):
                found.append({"id": list(act), "keys": keys, "kept": kept})
    return found


def write_backup(entries, holders=None):
    os.makedirs(os.path.dirname(BACKUP) or ".", exist_ok=True)
    payload = {
        "version": 2,
        "saved_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "holders": holders or [],
        "entries": entries,
    }
    # Write and fsync a temporary file in the same directory, then rename, so a
    # crash can never leave a half-written backup next to suppressed shortcuts.
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(BACKUP) or ".", prefix=".kde-shortcuts.")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(payload, f, indent=1)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, BACKUP)
    except Exception:
        os.unlink(tmp)
        raise


def read_backup():
    try:
        with open(BACKUP) as f:
            data = json.load(f)
    except FileNotFoundError:
        return None
    except (json.JSONDecodeError, OSError) as e:
        print(f"  the backup at {BACKUP} is unreadable ({e})", file=sys.stderr)
        print("  -> your shortcut *defaults* are untouched. Recover with:", file=sys.stderr)
        print("     System Settings -> Shortcuts -> Reset to Defaults", file=sys.stderr)
        sys.exit(1)
    if not isinstance(data, dict) or "entries" not in data:
        print(f"  {BACKUP} is not a shortcut backup", file=sys.stderr)
        sys.exit(1)
    return data


if ACTION == "status":
    data = read_backup()
    if not data:
        print("KDE shortcuts: nothing suppressed, everything is as you left it.")
        sys.exit(0)
    entries = data["entries"]
    holders = live_holders(data.get("holders"))
    print(f"KDE shortcuts: {len(entries)} action(s) suppressed since {data.get('saved_at', '?')}")
    if not tracked(data):
        print("  Written before holder tracking, so whether a window still needs")
        print("  them cannot be told from here. It will sort itself out once every")
        print("  window open at the time has been closed.")
    elif holders:
        print(f"  held by {len(holders)} live session(s): "
              + ", ".join(f"pid {h['pid']}" for h in holders))
        print("  They come back on their own when the last one closes.")
    else:
        print("  No session is holding them - one was killed before it could hand them back.")
    print(f"  backup: {BACKUP}")
    for e in entries[:8]:
        print(f"    {e['id'][0]}/{e['id'][1]}: {', '.join(human(k) for k in e['keys'])}")
    if len(entries) > 8:
        print(f"    ... and {len(entries) - 8} more")
    print("  -> put them back with:  omarchy-window-shortcuts restore")
    sys.exit(1)

if ACTION == "suppress":
    me = {"pid": int(HOLDER), "start": proc_start(HOLDER)} if HOLDER else None
    if me and not me["start"]:
        me = None  # claimed on behalf of a process that is already gone

    data = read_backup()
    if data:
        # Never rescan while a backup exists. The live state is already
        # suppressed, so a rescan would record those suppressed values as the
        # "originals" and the real ones would be gone for good.
        entries = data["entries"]
        holders = live_holders(data.get("holders"))
        if me and not any(h["pid"] == me["pid"] for h in holders):
            holders.append(me)
        if DRYRUN:
            print(f"[dry-run] {len(entries)} binding(s) already borrowed by {len(holders)} session(s);"
                  f" would join as holder {HOLDER or '(none)'}")
            sys.exit(0)
        write_backup(entries, holders)
        # Re-apply idempotently: a previous session may have died part-way
        # through, and this costs nothing when it did not.
        for e in entries:
            set_keys(e["id"], e["kept"])
        print(f"Joined an existing borrow of {len(entries)} binding(s);"
              f" {len(holders)} session(s) now holding.")
        sys.exit(0)

    entries = scan()
    if not entries:
        print("Nothing to do: no Meta+ shortcuts are bound in KDE.")
        sys.exit(0)
    if DRYRUN:
        print(f"[dry-run] would free {len(entries)} Meta+ binding(s) for Omarchy:")
        for e in entries:
            dropped = [human(k) for k in e["keys"] if k & META]
            keeps = [human(k) for k in e["kept"]]
            tail = f"  (keeps {', '.join(keeps)})" if keeps else ""
            print(f"    {e['id'][0]}/{e['id'][1]}: drop {', '.join(dropped)}{tail}")
        sys.exit(0)
    # The backup lands on disk before the first shortcut changes, never after.
    write_backup(entries, [me] if me else [])
    failed = [e for e in entries if not set_keys(e["id"], e["kept"])]
    freed = len(entries) - len(failed)
    print(f"Freed {freed} Meta+ binding(s) for Omarchy. Super on its own and Alt+Tab still belong to Plasma.")
    if failed:
        print(f"  {len(failed)} could not be changed:", file=sys.stderr)
        for e in failed[:5]:
            print(f"    {e['id'][0]}/{e['id'][1]}", file=sys.stderr)
        print("  -> those keys stay with Plasma; Omarchy will not see them.", file=sys.stderr)
        print("  -> everything else is still restorable:  omarchy-window-shortcuts restore",
              file=sys.stderr)
    sys.exit(0)

if ACTION == "restore":
    data = read_backup()
    if not data:
        print("Nothing to restore - no backup on disk.")
        sys.exit(0)
    entries = data["entries"]

    # A release is one session stepping back, not a decision for the others.
    # A bare `restore` skips this entirely and puts everything back - that is
    # the escape hatch the menu offers.
    if HOLDER:
        holders = [h for h in live_holders(data.get("holders")) if h["pid"] != int(HOLDER)]
        if holders:
            if DRYRUN:
                print(f"[dry-run] would step back, leaving {len(holders)} session(s) holding;"
                      " the keys would stay borrowed")
                sys.exit(0)
            write_backup(entries, holders)
            print(f"Stepped back; {len(holders)} session(s) still holding, so the keys stay borrowed.")
            sys.exit(0)

    if DRYRUN:
        print(f"[dry-run] would give {len(entries)} binding(s) back to Plasma:")
        for e in entries:
            print(f"    {e['id'][0]}/{e['id'][1]}: {', '.join(human(k) for k in e['keys'])}")
        sys.exit(0)
    failed = [e for e in entries if not set_keys(e["id"], e["keys"])]
    if failed:
        # Keep the backup. A partial restore that deleted its own evidence would
        # strand the rest with no way back.
        print(f"Restored {len(entries) - len(failed)} of {len(entries)}; {len(failed)} failed.",
              file=sys.stderr)
        print(f"  The backup is kept at {BACKUP} so you can retry:", file=sys.stderr)
        print("  -> omarchy-window-shortcuts restore", file=sys.stderr)
        print("  -> or System Settings -> Shortcuts -> Reset to Defaults", file=sys.stderr)
        sys.exit(1)
    os.unlink(BACKUP)
    print(f"Gave {len(entries)} binding(s) back to Plasma.")
    sys.exit(0)
PY
