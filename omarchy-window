#
# omarchy-window - run the Omarchy desktop in a window on your Plasma session.
#
# Sizes itself to KWin's real work area (your screen minus the Plasma panel) and
# installs a KWin rule so the window lands exactly there with no decoration.
# Same machine, same filesystem as Plasma - nothing to share.
#
#   omarchy-window              # full Omarchy (bar, menu, autostart)
#   omarchy-window --bare       # menu + bar, but no host-session env import
#   omarchy-window -s 1400x800  # explicit size, skips the KWin rule
#   omarchy-window --no-rule    # don't touch KWin rules
#
# Close the window to end the session. SUPER+ESCAPE opens Omarchy's system menu;
# SUPER+W closes a window inside it. SUPER+K lists every binding.

set -euo pipefail

SELF=$(readlink -f "$0")

# --- end the session when its window is closed ------------------------------
# Hyprland does not exit when its last output goes away. Closing the nested
# window leaves it running headless on a synthetic monitor named FALLBACK -
# a live session reports WAYLAND-1, an orphaned one reports FALLBACK - so every
# launch used to leave a compositor running for good. They accumulate silently:
# seven at once on the machine this was found on.
#
# Each instance records its pid in hyprland.lock, so this finds the instance
# belonging to *this* Hyprland rather than assuming the newest one, which would
# pick the wrong session the moment two windows are opened together.
gone_within() { # gone_within <seconds> <pid>
  local n="$1" pid="$2" i
  for ((i = 0; i < n; i++)); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 1
  done
  return 1
}

watch_for_close() { # watch_for_close <hyprland-pid>
  local pid="$1" sig="" f real armed=0 i lockpid
  for ((i = 0; i < 100; i++)); do
    for f in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/hypr/*/hyprland.lock; do
      [[ -r $f ]] || continue
      # The lock is two LINES - pid, then the wayland display - not one
      # space-separated line. `cut -d' ' -f1` reads every line and returns both
      # joined, which never equals a pid, so the instance was never found and
      # the session was never reaped.
      lockpid=""
      read -r lockpid < "$f" 2>/dev/null || true
      if [[ $lockpid == "$pid" ]]; then
        sig=$(basename "$(dirname "$f")"); break 2
      fi
    done
    sleep 0.2
  done
  # No instance found: say nothing and leave the session alone rather than
  # guessing at which compositor to shut down.
  [[ -n $sig ]] || return 0

  while kill -0 "$pid" 2>/dev/null; do
    sleep 2
    # `|| real=""` is load-bearing. Under `set -e` with pipefail an assignment
    # from a failing pipeline takes the pipeline's status and kills the script,
    # and hyprctl does fail transiently at exactly the moment a window closes -
    # so the watchdog used to die silently just as it was needed.
    real=$(HYPRLAND_INSTANCE_SIGNATURE=$sig hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
try:
    print(sum(1 for m in json.load(sys.stdin) if m.get("name") != "FALLBACK"))
except Exception:
    pass' 2>/dev/null) || real=""
    # An empty answer is hyprctl failing to reply, not a closed window. Acting
    # on it would kill a perfectly healthy session on a transient hiccup.
    [[ -n $real ]] || continue
    # Only arm once a real output has been seen: at startup there is a moment
    # before the nested output exists, and exiting there would kill the session
    # as it came up.
    (( real > 0 )) && { armed=1; continue; }
    (( armed )) || continue
    # Ask nicely, then insist. Every step is guarded: an unguarded failure here
    # exits the whole watchdog under `set -e`, which is what used to happen -
    # `dispatch exit` returns 7 on a Lua-dispatcher Hyprland, and the script died
    # on that line before it could ever fall back to a signal.
    #
    # Two spellings because the dispatcher changed: this Hyprland wants
    # `hl.dsp.exit()` and answers `hl.dispatch: expected a dispatcher` to the
    # older bare `exit`.
    HYPRLAND_INSTANCE_SIGNATURE=$sig hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1 || true
    gone_within 5 "$pid" && return 0
    HYPRLAND_INSTANCE_SIGNATURE=$sig hyprctl dispatch exit >/dev/null 2>&1 || true
    gone_within 5 "$pid" && return 0
    kill -TERM "$pid" 2>/dev/null || true
    gone_within 5 "$pid" && return 0
    kill -KILL "$pid" 2>/dev/null || true
    return 0
  done
}

SIZE=""; MODE=full; USE_RULE=1; DETACH=0; INSTALL_DESKTOP=0; GRAB_KEYS=1
while (($#)); do
  case "$1" in
    # Internal: run the watchdog for an already-started compositor.
    --watch-close) watch_for_close "${2:?--watch-close needs a pid}"; exit 0 ;;
    --bare) MODE=bare; shift ;;
    --no-rule) USE_RULE=0; shift ;;
    --no-key-grab) GRAB_KEYS=0; shift ;;
    --detach) DETACH=1; shift ;;
    --install-desktop) INSTALL_DESKTOP=1; shift ;;
    -s|--size) SIZE="$2"; USE_RULE=0; shift 2 ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 1 ;;
  esac
done

if (( INSTALL_DESKTOP )); then
  self=$(readlink -f "$0")
  # Prefer the command on PATH when it resolves to this same script, so the entry
  # follows package upgrades. Writing the absolute path pins whichever copy
  # happened to run --install-desktop - a working checkout, say - and then
  # upgrading the package silently never changes what the launcher starts.
  onpath=$(command -v omarchy-window 2>/dev/null || true)
  if [[ -n $onpath && $(readlink -f "$onpath") == "$self" ]]; then
    self=omarchy-window
  fi
  # icon.png is 300x300. logo.svg is a 1215x285 wordmark - a panel slot is square,
  # so the wordmark scales down into what looks like a horizontal line.
  src=/usr/share/omarchy/icon.png
  [[ -f $src ]] || src=/usr/share/omarchy/logo.svg
  # Install into the icon theme and reference it by name, so the panel, the task
  # manager and the launcher all resolve it and it survives cache regeneration.
  icon=omarchy-window
  icondir="$HOME/.local/share/icons/hicolor/256x256/apps"
  if mkdir -p "$icondir" && cp -f "$src" "$icondir/$icon.${src##*.}" 2>/dev/null; then
    gtk-update-icon-cache -qtf "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
  else
    icon="$src"   # fall back to an absolute path
  fi
  dir="$HOME/.local/share/applications"; mkdir -p "$dir"
  cat > "$dir/omarchy-window.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Omarchy (in a window)
Comment=Run the full Omarchy desktop in a window on this session
Exec=$self --bare --detach
Icon=$icon
Terminal=false
Categories=System;Utility;
Keywords=omarchy;hyprland;
StartupWMClass=aquamarine
EOF
  update-desktop-database "$dir" 2>/dev/null || true
  echo "Installed $dir/omarchy-window.desktop"
  echo "  icon:  $icon  (from $src)"
  echo "  Launch it from your application menu - no terminal, and the panel entry"
  echo "  now shows the Omarchy logo instead of a generic placeholder."
  exit 0
fi

[[ -n ${WAYLAND_DISPLAY:-} ]] || { echo "Needs a Wayland session." >&2; exit 1; }
command -v Hyprland >/dev/null || { echo "Hyprland not installed." >&2; exit 1; }
[[ -d /usr/share/omarchy ]] || { echo "Omarchy not installed." >&2; exit 1; }

QDBUS=$(for q in qdbus6 qdbus-qt6 qdbus; do command -v "$q" >/dev/null && echo "$q" && break; done)

# --- KWin's authoritative work area: screen minus panels -------------------
workarea() {
  [[ -n ${QDBUS:-} ]] || return 1
  local js id out
  js=$(mktemp --suffix=.js)
  cat > "$js" <<'JS'
var a = workspace.clientArea(KWin.MaximizeArea, workspace.activeScreen, workspace.currentDesktop);
print("OMARCHY_WA " + a.x + " " + a.y + " " + a.width + " " + a.height);
JS
  $QDBUS org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript omawin >/dev/null 2>&1 || true
  id=$($QDBUS org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$js" omawin 2>/dev/null) || { rm -f "$js"; return 1; }
  $QDBUS org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script.run >/dev/null 2>&1 || { rm -f "$js"; return 1; }
  sleep 0.6
  out=$(journalctl --user -b --since "-15s" 2>/dev/null | grep -o 'OMARCHY_WA .*' | tail -1)
  $QDBUS org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript omawin >/dev/null 2>&1 || true
  rm -f "$js"
  [[ -n $out ]] || return 1
  echo "${out#OMARCHY_WA }"
}

# Fallback: largest ENABLED output (a disabled panel must not be considered).
fallback_size() {
  local w h
  read -r w h < <(kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
    | awk '/^Output:/{en=0} /^[[:space:]]+enabled$/{en=1}
           /Geometry:/{if(en){split($3,g,"x"); print g[1], g[2]}}' | sort -rn | head -1)
  [[ -n ${w:-} && -n ${h:-} ]] && echo "$w $h" || echo "1280 720"
}

WA_X=0; WA_Y=0
if [[ -z $SIZE ]]; then
  if wa=$(workarea); then
    read -r WA_X WA_Y WA_W WA_H <<<"$wa"
    SIZE="${WA_W}x${WA_H}"
    FITTED="KWin work area (screen minus panel) at ${WA_X},${WA_Y}"
  else
    read -r WA_W WA_H < <(fallback_size)
    SIZE="${WA_W}x${WA_H}"; USE_RULE=0
    FITTED="largest enabled output (KWin query unavailable)"
  fi
fi

# --- KWin rule: place the nested window exactly, with no decoration --------
# The nested compositor's window class is 'aquamarine' (Hyprland's backend).
if (( USE_RULE )) && [[ -n ${QDBUS:-} ]]; then
  python3 - "$HOME/.config/kwinrulesrc" "$WA_X" "$WA_Y" "${SIZE%x*}" "${SIZE#*x}" <<'PY'
import configparser, sys
path, x, y, w, h = sys.argv[1], *sys.argv[2:6]
UUID = "omarchy-nested-window"
cp = configparser.RawConfigParser(); cp.optionxform = str
cp.read(path)
if not cp.has_section("General"): cp.add_section("General")
rules = [r for r in cp["General"].get("rules", "").split(",") if r]
if UUID not in rules: rules.append(UUID)
cp["General"]["rules"] = ",".join(rules)
cp["General"]["count"] = str(len(rules))
if cp.has_section(UUID): cp.remove_section(UUID)
cp.add_section(UUID)
cp[UUID].update({
    "Description": "Omarchy nested window (managed by omarchy-window)",
    "wmclass": "aquamarine", "wmclasscomplete": "false", "wmclassmatch": "1",
    "position": f"{x},{y}", "positionrule": "2",
    "size": f"{w},{h}",     "sizerule": "2",
    "noborder": "true",     "noborderrule": "2",
})
with open(path, "w") as f: cp.write(f, space_around_delimiters=False)
PY
  $QDBUS org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
  RULED=1
fi

# --- keyboard handover -----------------------------------------------------
# KWin consumes Meta+... combinations it holds global shortcuts for before the
# nested compositor is ever offered the key, which is most of Omarchy's keymap.
# The clean protocol for this is zwp_keyboard_shortcuts_inhibit_v1, but the
# Wayland backend does not request it - Hyprland only implements the server half
# for its own clients. So we take the keys from KDE directly.
#
# This used to load a KWin script that called KGlobalAccel's
# blockGlobalShortcuts as the window gained and lost focus. That was focus-
# aware, but all-or-nothing: it also silenced Super on its own (KWin's
# modifier-only launcher shortcut) and Alt+Tab, neither of which Omarchy uses
# and both of which you still want from Plasma.
#
# omarchy-window-shortcuts instead clears only the combinations carrying the
# Meta modifier, which leaves Super-alone and Alt+Tab untouched - see that
# script for why that one rule is enough. The cost is that it is no longer
# focus-driven: a KWin script can pass a bool over D-Bus but not the integer
# array this needs (KWin logs "no slot matched"), so the keys are lent for as
# long as the window is open and handed back when it closes.
SHORTCUTS=$(command -v omarchy-window-shortcuts 2>/dev/null || true)
[[ -n $SHORTCUTS ]] || SHORTCUTS="$(dirname "$(readlink -f "$0")")/omarchy-window-shortcuts"
unblock_shortcuts() {
  [[ -x $SHORTCUTS ]] || return 0
  # --release, not a bare restore: another window may still be open and using
  # these keys. The keys go back only when the last holder lets go.
  "$SHORTCUTS" restore --release $$ >/dev/null 2>&1 || true
}
grab_shortcuts() {
  # Returning 0 here would make the caller print that Omarchy has the keys
  # while nothing had been changed - a false success.
  [[ -x $SHORTCUTS ]] || return 1
  # Claiming rather than restore-then-suppress. suppress joins an existing
  # borrow when one is live, and prunes holders whose process is gone, so a
  # session that was killed heals instead of stranding the keys.
  "$SHORTCUTS" suppress --claim $$ >/dev/null 2>&1
}

if (( GRAB_KEYS )); then
  if grab_shortcuts; then
    KEYS="Omarchy has KDE's Meta+ keys; Super alone and Alt+Tab still work in Plasma"
  else
    KEYS="could not borrow KDE's Meta+ keys - your desktop keeps them"
    KEYS_FIX=1
  fi
fi

# --- keep what Omarchy launches inside this window -------------------------
# Omarchy starts apps with `uwsm-app`, which does not run them: it hands the
# command to wayland-wm-app-daemon.service. That is a systemd *user* unit, so it
# carries the environment of whichever session last imported one - on a Plasma
# host, Plasma's. Probed here it hands every app WAYLAND_DISPLAY=wayland-0,
# XDG_CURRENT_DESKTOP=KDE and no HYPRLAND_INSTANCE_SIGNATURE, whoever called it.
#
# So the agent keybinding, the terminal, the file manager - everything Omarchy
# launches from inside this window - opens on the host desktop instead, detached
# from the compositor that asked for it. uwsm-app has no bypass flag, so the
# nested session gets a uwsm-app of its own, earlier on PATH, that runs the
# command directly and lets it inherit this compositor.
#
# Every one of Omarchy's 31 call sites uses the same `uwsm-app -- <command>`
# form, so that is all the shim has to understand. `uwsm app --` (the separate
# binary, used only by omarchy-windows-vm) is not shimmed and still goes to the
# host.
SHIMDIR=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/omarchy-window-shim.XXXXXX")
REAL_UWSM=$(command -v uwsm-app 2>/dev/null || echo /usr/bin/uwsm-app)
cat > "$SHIMDIR/uwsm-app" <<'SHIM'
#!/bin/sh
# Installed by omarchy-window for one nested session. Not a system file.
case "${1:-}" in ping | stop) exit 0 ;; esac

# Every Omarchy call site spells it `uwsm-app -- <command>`, so take what
# follows the first standalone "--" and run it right here, inheriting this
# compositor instead of the host's.
for a in "$@"; do
  [ "$a" = "--" ] || continue
  while [ "$#" -gt 0 ]; do
    [ "$1" = "--" ] && { shift; break; }
    shift
  done
  [ "$#" -gt 0 ] || exit 0
  exec "$@"
done

# No "--" to anchor on. Options that take a separate value (-s SLICE, -a NAME)
# would make a guess here exec the value as a command, so hand the whole thing
# to the real uwsm-app rather than invent a parse for a form Omarchy never uses.
exec @REAL_UWSM@ "$@"
SHIM
sed -i "s|@REAL_UWSM@|$REAL_UWSM|" "$SHIMDIR/uwsm-app"
chmod +x "$SHIMDIR/uwsm-app"

# One handler, armed before anything that can exit early. A second
# `trap ... EXIT` silently replaces the first, which is how the temporary config
# directory used to leak on every run.
cleanup() {
  unblock_shortcuts
  rm -rf "$SHIMDIR" ${CFG:+"$(dirname "$CFG")"}
}
trap cleanup EXIT INT TERM

# --- generate the nested config -------------------------------------------
CFG="$(mktemp -d)/nested.lua"
{
  echo 'dofile((os.getenv("OMARCHY_PATH") or "/usr/share/omarchy") .. "/default/hypr/bootstrap.lua")'
  if [[ $MODE == bare ]]; then
    # Omarchy's autostart also runs `systemctl --user import-environment`, which
    # would overwrite WAYLAND_DISPLAY in your HOST user session. Stub the module,
    # then start just the shell - the menu and bar are shell plugins, so without
    # it SUPER+SPACE has no backend to talk to.
    echo 'package.loaded["default.hypr.autostart"] = true'
  fi
  echo 'require("default.hypr.omarchy")'
  for m in input bindings looknfeel; do echo "pcall(require, \"hypr.$m\")"; done
  if [[ $MODE == bare ]]; then
    echo 'hl.on("hyprland.start", function() hl.exec_cmd("omarchy-launch-shell") end)'
  fi
  echo 'hl.env("GDK_SCALE", "1")'
  # Hyprland's children inherit this, so the shim covers the terminal you open
  # by hand as well as anything the bindings launch. Escaped for Lua, not shell.
  lua_path="$SHIMDIR:$PATH"
  lua_path=${lua_path//\\/\\\\}
  lua_path=${lua_path//\"/\\\"}
  echo "hl.env(\"PATH\", \"$lua_path\")"
  echo "hl.monitor({ output = \"\", mode = \"${SIZE}@60\", position = \"0x0\", scale = 1 })"
  echo 'pcall(require, "default.hypr.toggles")'
} > "$CFG"

Hyprland --verify-config -c "$CFG" >/dev/null 2>&1 || {
  echo "Config failed validation:" >&2; Hyprland --verify-config -c "$CFG" >&2; exit 1; }

echo "Omarchy nested window: ${SIZE}"
[[ -n ${FITTED:-} ]] && echo "  sized to: $FITTED"
[[ -n ${RULED:-} ]] && echo "  KWin rule installed (exact position, no titlebar)"
echo "  mode: $MODE"
echo
if [[ -n ${KEYS:-} ]]; then
  echo "  keys: $KEYS"
  if [[ -n ${KEYS_FIX:-} ]]; then
    cat <<'KEYSFIX'
        Omarchy's Super+ bindings will be swallowed by your desktop. To fix:
          - KDE: check the helper runs on its own and says what is wrong:
              omarchy-window-shortcuts suppress --dry-run
            It needs gdbus and python3 (pacman -S --needed glib2 python) and a
            live Plasma session.
          - Other desktops: unbind the conflicting Super+ shortcuts, or run with
            --no-key-grab to silence this and accept the conflict.
        Nothing was changed on your system by the failed attempt.
KEYSFIX
  fi
fi
echo

if (( DETACH )); then
  keep="${XDG_RUNTIME_DIR:-/tmp}/omarchy-window-$$.lua"
  cp "$CFG" "$keep"
  # The cleanup must follow Hyprland, not this shell, or Plasma never gets its
  # Meta+ keys back after the window closes. The shim has to outlive this shell
  # too - the nested session resolves it on every launch, not just at startup.
  # \$\$ expands inside the background shell (its own pid); $$ expands now (this
  # one's). The background claims itself BEFORE releasing this shell's claim, so
  # there is no instant where nobody holds the keys and they snap back to Plasma.
  setsid bash -c "'$SHORTCUTS' suppress --claim \$\$ >/dev/null 2>&1
    '$SHORTCUTS' restore --release $$ >/dev/null 2>&1
    Hyprland -c '$keep' >/dev/null 2>&1 < /dev/null &
    hp=\$!
    '$SELF' --watch-close \$hp >/dev/null 2>&1 &
    wd=\$!
    wait \$hp
    kill \$wd 2>/dev/null
    '$SHORTCUTS' restore --release \$\$ >/dev/null 2>&1
    rm -f '$keep'
    rm -rf '$SHIMDIR'" >/dev/null 2>&1 &
  echo "Started in the background (pid $!)."
  # The background session owns the shim and the config now, so this shell must
  # not take them away on the way out.
  trap - EXIT INT TERM
  exit 0
fi

Hyprland -c "$CFG" &
HYPR_PID=$!
"$SELF" --watch-close "$HYPR_PID" >/dev/null 2>&1 &
WATCHDOG=$!
wait "$HYPR_PID"
kill "$WATCHDOG" 2>/dev/null
cleanup
