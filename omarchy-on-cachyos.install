post_install() {
  cat <<'MSG'
  omarchy-on-cachyos is on your PATH. Start with:

      ooc                         menu, with a status panel
      ooc status                  print state and exit

  `ooc` is the short name for `omarchy-on-cachyos`; either works everywhere.

  Other commands: omarchy-window, omarchy-window-shortcuts, omarchy-oc-install,
  omarchy-oc-block-updates, omarchy-oc-verify-boot, omarchy-oc-preserve-identity,
  omarchy-oc-clean-boot, omarchy-oc-uninstall.

  Already-open shells cache their command lookup. In this one, run:
      bash: hash -r      zsh: rehash      fish: (picks it up on its own)
MSG
}
post_upgrade() { post_install; }
